node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# build caches
.turbo
.swc/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide
.idea/
.vscode/*
!.vscode/extensions.json

# claude code (machine-local)
.claude/settings.local.json
# vercel marketplace 통합이 설치한 에이전트 스킬
.agents/

# unity — 에디터가 생성하는 것들 (생성된 Protocol.cs 는 커밋한다)
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/Build/
unity/Packages/packages-lock.json
unity/*.csproj
unity/*.sln
unity/Build/

# 블록아웃은 생성물이다 — 생성기(tools/blockout, BlockoutCharacter.cs)가 원본이다.
# 예산이 바뀌면 다시 뽑으면 되고, 무엇이 왜 그 폴리 수인지는 코드에만 남는다.
unity/mono_crash.*.json
