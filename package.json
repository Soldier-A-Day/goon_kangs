{
  "name": "soldier-a-day",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sad/web",
    "dev:web": "npm run dev --workspace @sad/web",
    "dev:server": "npm run dev --workspace @sad/gameserver",
    "sim": "npm run start --workspace @sad/simrunner --",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "codegen:csharp": "npm run start --workspace @sad/csharpgen -- ../../unity/Assets/Scripts/Generated/Protocol.cs"
  }
}