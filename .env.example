# 웹 셸 → 게임 서버. 게임 서버는 Vercel Function이 아니라 상시 구동 Node 프로세스다.
# 로비·대기실·플레이 화면만 이걸 쓴다. 기록·장부는 Supabase를 직접 읽으므로
# 게임 서버가 꺼져 있어도 뜬다.
NEXT_PUBLIC_GAME_HTTP_URL=http://localhost:8080
NEXT_PUBLIC_GAME_WS_URL=ws://localhost:8080/ws

# 웹 셸 → Supabase (읽기 전용). 공개 키만 쓴다 — RLS의 SELECT 정책만 통과한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 배포 후 런타임 에러 수집(Sentry). 비워두면 완전 무동작 — sentry.io에서
# Next.js 프로젝트를 만들고 발급받은 DSN을 넣으면 그것만으로 켜진다.
NEXT_PUBLIC_SENTRY_DSN=

# 게임 서버
PORT=8080
CORS_ORIGIN=*

# 게임 서버 → 저장소. 없으면 인메모리로 돌아간다(로컬 개발·테스트).
# 런 스냅샷 — 24시간 TTL (17.0)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 영속 기록 — service_role 키는 서버 전용이며 절대 브라우저로 나가면 안 된다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
